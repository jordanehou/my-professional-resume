{
  "family": "portfolio-task-jordan",
  "networkMode": "awsvpc",
  "executionRoleArn": "arn:aws:iam::885684264653:role/resume_ecs_task_execution_role_jordan",
  "cpu": "256",
  "memory": "512",
  "requiresCompatibilities": ["FARGATE"],
  "containerDefinitions": [
    {
      "name": "portfolio-app",
      "image": "portfolio-app:latest",
      "essential": true,
      "portMappings": [
        { "containerPort": 80, "hostPort": 80, "protocol": "tcp" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/portfolio-app-jordan",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
